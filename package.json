{
  "name": "erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "db:reset": "node --experimental-strip-types scripts/reset.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm run test",
    "vercel-build": "node --experimental-strip-types scripts/vorbereiten.ts && next build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "bwip-js": "^4.5.1",
    "geist": "^1.7.2",
    "next": "^16.3.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.6"
  }
}
