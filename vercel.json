{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron?task=webhooks",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron?task=jobs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron?task=reconcile",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron?task=tracking",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron?task=wache",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron?task=housekeeping",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron?task=finanzen",
      "schedule": "0 5 * * *"
    }
  ]
}
