# Vorlage — diese Datei wird von der Anwendung NICHT gelesen.
# Zum Verwenden einmal kopieren:   cp .env.example .env
# Beim Betrieb über Docker Compose reicht die Datei .env in den Container
# durch; DATABASE_URL wird dabei durch die Datenbank im Compose-Netz ersetzt.

# --- Docker Compose --------------------------------------------------------
# Nur für den Betrieb über `docker compose up`: Port auf dem eigenen Rechner,
# falls 3000 schon belegt ist. Im Container läuft das ERP immer auf 3000.
# ERP_PORT=3001
#
# DATABASE_URL, PORT und NODE_ENV setzt die Compose-Datei selbst — die Werte
# unten gelten für den Betrieb ohne Docker.

# --- Datenbank -------------------------------------------------------------
# Lokal (Entwicklung): postgres://postgres@localhost:5433/erp
# Supabase auf Vercel:  Transaction Pooler (Port 6543) — pro Aufruf eine
# kurze Verbindung, das passt zu zustandslosen Funktionen.
DATABASE_URL=postgres://postgres@localhost:5433/erp

# Nur nötig, wenn DATABASE_URL auf den Transaction Pooler zeigt: Migration
# und Seed brauchen eine echte Sitzung (Session Pooler, Port 5432).
# Lokal und im Docker-Betrieb leer lassen.
# DIRECT_URL=

# --- Sitzungen -------------------------------------------------------------
# Beliebiger langer Zufallswert, z. B. `openssl rand -hex 32`
SESSION_SECRET=

# --- Shopify ---------------------------------------------------------------
# Leer lassen heißt: Shopify ist aus. Beispielwerte stehen bewusst nur im
# Kommentar — ein Platzhalter als Wert würde die Anbindung scharf schalten
# und die Warteschlange mit Fehlversuchen füllen.
#
# App im Dev Dashboard (dev.shopify.com) anlegen, alle nötigen Scopes geben
# (read_orders, read_all_orders — sonst nur die letzten 60 Tage!, write_orders, read_customers, read_products,
# write_merchant_managed_fulfillment_orders, read_inventory, write_inventory,
# read_locations) und im eigenen Shop installieren. Client ID und Secret
# stehen dort unter Settings > Credentials; das ERP tauscht sie selbst gegen
# ein Access Token (Client-Credentials-Grant, 24 h, wird automatisch erneuert).
#
#   SHOPIFY_SHOP_DOMAIN=meinshop.myshopify.com    (die .myshopify.com-Adresse)
#   SHOPIFY_CLIENT_ID=...                          (Settings > Credentials)
#   SHOPIFY_CLIENT_SECRET=...
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# Nur für Alt-Apps von vor 2026 mit statischem Admin-Token (shpat_...) —
# bei Client ID/Secret leer lassen.
SHOPIFY_ADMIN_TOKEN=

# Webhook-Signatur: Webhooks der eigenen App signiert Shopify mit dem Client
# Secret, dann kann diese Zeile leer bleiben. Nur wenn Webhooks über die
# Admin-Seite (Einstellungen > Benachrichtigungen) registriert sind, gehört
# hier deren Signatur-Schlüssel hinein. Webhooks brauchen ohnehin eine
# öffentlich erreichbare URL — lokal übernimmt der viertelstündliche Abgleich.
SHOPIFY_WEBHOOK_SECRET=

# --- DHL Parcel DE Shipping API v2 ----------------------------------------
DHL_API_BASE=https://api-sandbox.dhl.com
DHL_API_KEY=
DHL_API_SECRET=
DHL_GKP_USER=
DHL_GKP_PASSWORD=
# 14-stellige Abrechnungsnummer (EKP + Verfahren + Teilnahme)
DHL_BILLING_NUMBER=
DHL_RETURN_RECEIVER_ID=deu

# --- E-Mail (Resend) -------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM="Einkauf <einkauf@example.com>"

# --- Cron ------------------------------------------------------------------
# Schützt /api/cron/* vor fremden Aufrufen (Vercel sendet ihn als Bearer-Token)
CRON_SECRET=

# --- KI-Analyse ------------------------------------------------------------
# Schlüssel aus der Anthropic Console. Ohne Schlüssel ist die Seite /ki
# deaktiviert - alle anderen Module laufen unabhängig davon.
ANTHROPIC_API_KEY=
# Optional anderes Modell (Standard: claude-opus-5)
# ANTHROPIC_MODEL=

# --- Öffentliche Adresse ----------------------------------------------------
# Nur für die Webhook-Registrierung auf dem Ereignis-Monitor vorbelegt.
# Auf Vercel z. B. https://erp-xyz.vercel.app — lokal leer lassen.
# ERP_PUBLIC_URL=
